<!--
  语言支持：IDE 只留词法层（高亮、括号、注释），语义全部由 emmylua_ls 经 LSP4IJ 提供。
  设计见 docs/design/lsp-migration.md。
-->
<idea-plugin>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="lua" implementationClass="com.fixcode.intellij.lua.lang.LuaFileType" fieldName="INSTANCE"
                  language="Lua" extensions="lua;lua.txt"/>
        <lang.parserDefinition language="Lua" implementationClass="com.fixcode.intellij.lua.lang.LuaParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Lua" implementationClass="com.fixcode.intellij.lua.highlighting.LuaSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.fixcode.intellij.lua.highlighting.LuaColorSettingsPage"/>
        <!-- 旧版的配色方案，原样保留：升级后代码颜色不变 -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/Default.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/Darcula.xml"/>
        <lang.commenter language="Lua" implementationClass="com.fixcode.intellij.lua.editor.LuaCommenter"/>
        <lang.braceMatcher language="Lua" implementationClass="com.fixcode.intellij.lua.editor.LuaBraceMatcher"/>
        <lang.quoteHandler language="Lua" implementationClass="com.fixcode.intellij.lua.editor.LuaQuoteHandler"/>

        <!-- 编辑小功能：都只靠词法器（editor/LuaBlocks），不建语法树 -->
        <lineIndentProvider implementation="com.fixcode.intellij.lua.editor.LuaLineIndentProvider"/>
        <enterHandlerDelegate implementation="com.fixcode.intellij.lua.editor.LuaEnterHandler"/>
        <typedHandler implementation="com.fixcode.intellij.lua.editor.LuaTypedHandler"/>
        <codeInsight.template.postfixTemplateProvider language="Lua" implementationClass="com.fixcode.intellij.lua.editor.LuaPostfixTemplateProvider"/>
        <intentionAction>
            <language>Lua</language>
            <className>com.fixcode.intellij.lua.editor.LuaGenerateFunctionDocIntention</className>
            <category>Lua</category>
        </intentionAction>
        <lang.surroundDescriptor language="Lua" implementationClass="com.fixcode.intellij.lua.editor.LuaSurroundDescriptor"/>

        <!-- LSP4IJ 对自定义语言要显式绑定的几项（其余功能对任意语言自动生效） -->
        <lang.foldingBuilder language="Lua" order="first"
                             implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>
        <codeInsight.parameterInfo language="Lua" order="first"
                                   implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>
        <!-- 结构窗口不用 LSP4IJ 的 documentSymbol 版：它只在打开时取一次，服务器没准备好就一直是空的 -->
        <lang.psiStructureViewFactory language="Lua" order="first"
                                      implementationClass="com.fixcode.intellij.lua.structure.LuaStructureViewFactory"/>
        <callHierarchyProvider language="Lua" order="first"
                               implementationClass="com.redhat.devtools.lsp4ij.features.callHierarchy.LSPCallHierarchyProvider"/>
        <typeHierarchyProvider language="Lua" order="first"
                               implementationClass="com.redhat.devtools.lsp4ij.features.typeHierarchy.LSPTypeHierarchyProvider"/>

        <applicationService serviceImplementation="com.fixcode.intellij.lua.project.LuaSettings"/>
        <projectService serviceImplementation="com.fixcode.intellij.lua.project.LuaProjectSettings"/>
        <!-- UE 声明目录（UELink 后台生成 / UnLua）出现或换了时重启 emmylua_ls -->
        <postStartupActivity implementation="com.fixcode.intellij.lua.project.UnrealDeclWatcherActivity"/>
        <!-- 项目树「外部库」里显示 UE 声明和额外库目录（只为浏览，语义仍由 emmylua_ls 做） -->
        <additionalLibraryRootsProvider implementation="com.fixcode.intellij.lua.project.LuaLibraryRootsProvider"/>
        <notificationGroup id="EmmyLua UE Declarations" displayType="BALLOON"/>
        <projectConfigurable groupId="language" id="preferences.Lua" displayName="EmmyLua"
                             instance="com.fixcode.intellij.lua.project.LuaSettingsConfigurable"/>

        <fileTemplateGroup implementation="com.fixcode.intellij.lua.actions.LuaFileTemplateProvider"/>
        <defaultLiveTemplates file="/liveTemplates/lua.xml"/>
        <liveTemplateContext contextId="LUA_CODE" implementation="com.fixcode.intellij.lua.editor.LuaTemplateContextType"/>

        <xdebugger.breakpointType implementation="com.fixcode.intellij.lua.debugger.LuaLineBreakpointType"/>

        <!-- 注释翻译（照 UEToVS）：悬停文档里的注释后台翻译、「翻译选中内容」。开着翻译时 LSP4IJ 对 Lua 的悬停让给这里，
             见 translation/TranslatedHover.kt -->
        <platform.backend.documentation.targetProvider id="EmmyLuaTranslatedHover" order="first"
                                                       implementation="com.fixcode.intellij.lua.translation.TranslatedHoverTargetProvider"/>
        <applicationService serviceImplementation="com.fixcode.intellij.lua.translation.LuaTranslationSettings"/>
        <projectConfigurable parentId="preferences.Lua" id="preferences.Lua.translation" displayName="注释翻译"
                             instance="com.fixcode.intellij.lua.translation.LuaTranslationConfigurable" nonDefaultProject="false"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="emmylua" name="EmmyLua" factoryClass="com.fixcode.intellij.lua.lsp.EmmyLuaServerFactory">
            <description><![CDATA[
            EmmyLua 语言服务器（<a href="https://github.com/EmmyLuaLs/emmylua-analyzer-rust">emmylua_ls</a>）：
            跳转、补全、查找引用、重命名、诊断、格式化、语义高亮。配置写在工作区的 <code>.emmyrc.json</code>。
            ]]></description>
        </server>
        <languageMapping language="Lua" serverId="emmylua" languageId="lua"/>
        <semanticTokensColorsProvider serverId="emmylua"
                                      class="com.fixcode.intellij.lua.lsp.EmmyLuaSemanticTokensColors"/>
    </extensions>

    <actions>
        <action class="com.fixcode.intellij.lua.translation.TranslateSelectionAction" id="lua.translate.selection"
                text="翻译选中内容" description="翻译选中的文字；没有选中时翻译光标所在的整段注释">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift Y"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action class="com.fixcode.intellij.lua.translation.ClearTranslationCacheAction" id="lua.translate.clearCache"
                text="清空翻译缓存" description="删除本机缓存的注释译文（换了翻译服务或觉得译文不对时用）"/>
        <action class="com.fixcode.intellij.lua.actions.CreateLuaFileAction" text="Lua File" id="lua.newFile">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
        <action class="com.fixcode.intellij.lua.actions.CopyLuaRelativePathAction"
                text="Copy Lua Module Path" id="lua.copyReference.copyRelativePath">
            <add-to-group group-id="CopyReferencePopupGroup"/>
        </action>
        <action class="com.fixcode.intellij.lua.actions.CopyLuaRequirePathAction"
                text="Copy Lua Require Path" id="lua.copyReference.copyRequirePath">
            <add-to-group group-id="CopyReferencePopupGroup"/>
        </action>
        <action class="com.fixcode.intellij.lua.actions.GenerateUnrealDeclAction" id="lua.unrealDecl.generate"
                icon="/icons/ueDecl.svg"
                text="生成 UE Lua 声明" description="让开着的 UE 编辑器经 UELink 马上生成 / 刷新 UE 反射的 Lua 声明（只写变了的文件）">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
            <add-to-group group-id="NavBarToolBar" anchor="first"/>
        </action>
        <group id="lua.unrealDecl" text="UE 反射声明（EmmyLua）" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action class="com.fixcode.intellij.lua.actions.RefreshUnrealDeclAction" id="lua.unrealDecl.refresh"
                    text="刷新 UE 反射声明" description="让 UE 编辑器马上比对一遍，只写变了的声明文件"/>
            <action class="com.fixcode.intellij.lua.actions.LoadBlueprintsUnrealDeclAction" id="lua.unrealDecl.loadBlueprints"
                    text="补全全部蓝图声明" description="让 UE 编辑器在后台逐个加载没打开过的蓝图，补全成员"/>
            <action class="com.fixcode.intellij.lua.actions.RebuildUnrealDeclAction" id="lua.unrealDecl.rebuild"
                    text="全部重写 UE 反射声明" description="不看清单，重写全部声明文件"/>
        </group>
    </actions>
</idea-plugin>
