<!--
  MCP 的注册（设计文档第 6 节）。

  由 emmylua-debug.xml 的「MCP」段用
      <xi:include href="emmylua-debug-mcp.xml" xpointer="xpointer(/idea-plugin/*)"/>
  引入；和 emmylua-debug.xml 一样，P8 切换之前不被 plugin.xml 引用。单独一个文件是为了
  MCP 线程和 UI 线程改注册时不互相冲突。
-->
<idea-plugin>
    <extensionPoints>
        <!-- 引擎适配层把项目的调试引擎交给 MCP（LuaDebugSessionManager → LuaDebugBackend） -->
        <extensionPoint qualifiedName="com.fixcode.intellij.lua.debug.mcpBackend"
                        interface="com.fixcode.intellij.lua.debug.mcp.LuaMcpBackendProvider" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.fixcode.intellij.lua">
        <debug.mcpService implementation="com.fixcode.intellij.lua.debug.mcp.LuaMcpServiceImpl"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.fixcode.intellij.lua.debug.mcp.LuaMcpStartupActivity"/>
    </extensions>
</idea-plugin>
