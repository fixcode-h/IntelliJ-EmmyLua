<!--
  新调试链路（附加 + 真机 + MCP）的注册。

  按设计文档 12.1「新建后一次性切换」：P8 之前这个文件不被 plugin.xml 引用，
  新旧两套不会同时出现在用户面前。本地试用时在 plugin.xml 里临时加一行
      <xi:include href="emmylua-debug.xml" xpointer="xpointer(/idea-plugin/*)"/>
  即可（不要提交这行）。P8 切换 PR 正式加上并删掉旧的 debugger/ 注册。

  各并行线程只往自己的段落里加注册，避免互相冲突：
    - 引擎：debug.processFactory
    - Android 真机：debug.deviceService
    - MCP：debug.mcpService 以及 MCP 自己的服务
    - UI：其余
-->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <extensionPoints>
        <extensionPoint qualifiedName="com.fixcode.intellij.lua.debug.processFactory"
                        interface="com.fixcode.intellij.lua.debug.api.LuaDebugProcessFactory" dynamic="true"/>
        <extensionPoint qualifiedName="com.fixcode.intellij.lua.debug.deviceService"
                        interface="com.fixcode.intellij.lua.debug.api.LuaDeviceService" dynamic="true"/>
        <extensionPoint qualifiedName="com.fixcode.intellij.lua.debug.mcpService"
                        interface="com.fixcode.intellij.lua.debug.api.LuaMcpService" dynamic="true"/>
        <extensionPoint qualifiedName="com.fixcode.intellij.lua.debug.processTagProvider"
                        interface="com.fixcode.intellij.lua.debug.api.LuaProcessTagProvider" dynamic="true"/>
    </extensionPoints>

    <!-- ===== 引擎 ===== -->
    <extensions defaultExtensionNs="com.fixcode.intellij.lua">
        <debug.processFactory implementation="com.fixcode.intellij.lua.debug.xdebugger.LuaV3DebugProcessFactory"/>
        <debug.processFactory implementation="com.fixcode.intellij.lua.debug.xdebugger.AndroidDebugProcessFactory"/>
        <debug.processFactory implementation="com.fixcode.intellij.lua.debug.xdebugger.LocalProcessDebugProcessFactory"/>
        <debug.mcpBackend implementation="com.fixcode.intellij.lua.debug.xdebugger.LuaEngineMcpBackendProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <xdebugger.breakpointType implementation="com.fixcode.intellij.lua.debug.xdebugger.LuaExceptionBreakpointType"/>
        <!-- 暂停时在编辑器行尾显示变量值 -->
        <editor.linePainter implementation="com.fixcode.intellij.lua.debug.xdebugger.LuaInlineValuePainter"/>
    </extensions>

    <!-- ===== Android 真机 ===== -->
    <extensions defaultExtensionNs="com.fixcode.intellij.lua">
        <debug.deviceService implementation="com.fixcode.intellij.lua.debug.android.AndroidLuaDeviceService"/>
    </extensions>

    <!-- ===== MCP =====（注册放在 MCP 线程自己的文件里，互不冲突） -->
    <xi:include href="emmylua-debug-mcp.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <!-- ===== UI ===== -->
    <extensions defaultExtensionNs="com.fixcode.intellij.lua">
        <debug.processTagProvider implementation="com.fixcode.intellij.lua.debug.ui.process.UnrealProcessTagProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="com.fixcode.intellij.lua.debug.ui.session.LuaRunConfigurationType"/>
        <configurationType implementation="com.fixcode.intellij.lua.debug.ui.device.LuaLegacyDeviceConfigurationType"/>
        <programRunner implementation="com.fixcode.intellij.lua.debug.ui.session.LuaDebugRunner"/>
        <xdebugger.attachDebuggerProvider implementation="com.fixcode.intellij.lua.debug.ui.attach.LuaAttachDebuggerProvider"/>
        <xdebugger.attachDebuggerProvider implementation="com.fixcode.intellij.lua.debug.ui.device.LuaDeviceAttachDebuggerProvider"/>
        <xdebugger.attachHostProvider implementation="com.fixcode.intellij.lua.debug.ui.device.LuaDeviceAttachHostProvider"/>

        <applicationConfigurable parentId="tools"
                                 id="emmylua.debug"
                                 bundle="messages.LuaDebugBundle"
                                 key="settings.title"
                                 instance="com.fixcode.intellij.lua.debug.ui.settings.LuaDebugConfigurable"/>

        <notificationGroup id="EmmyLua Debug" displayType="BALLOON" bundle="messages.LuaDebugBundle" key="notification.group"/>
    </extensions>

    <!-- ===== UE 热重载（经 UELink lua.reload）和断点诊断 ===== -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="EmmyLua UE Reload" displayType="BALLOON"/>
    </extensions>
    <applicationListeners>
        <listener class="com.fixcode.intellij.lua.debug.ue.UnrealReloadOnSaveListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
    <actions>
        <!-- Ctrl+Alt+R 在默认键位里只有比较视图里的 Diff.ApplyLeftSide 用，这个动作只在 Lua 文件上可用，不冲突；
             macOS 键位里 ⌘⌥R 是 Resume、⌃⌥R 是 Run…，改用 ⌃⌥U -->
        <action id="EmmyLua.Debug.ReloadToUnreal" class="com.fixcode.intellij.lua.debug.ue.ReloadToUnrealAction">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt R"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt U" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt U" replace-all="true"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="EmmyLua.Debug.DiagnoseBreakpoints" class="com.fixcode.intellij.lua.debug.xdebugger.DiagnoseBreakpointsAction">
            <add-to-group group-id="RunMenu" anchor="last"/>
            <add-to-group group-id="XDebugger.ToolWindow.TopToolbar3.Extra" anchor="last"/>
        </action>
    </actions>

    <actions>
        <group id="EmmyLua.Debug.Tools" popup="true" text="EmmyLua 调试">
            <action id="EmmyLua.Debug.OpenMcpSettings"
                    class="com.fixcode.intellij.lua.debug.ui.mcp.OpenMcpServerSettingsAction"/>
            <action id="EmmyLua.Debug.McpStatus"
                    class="com.fixcode.intellij.lua.debug.ui.mcp.ShowMcpStatusAction"/>
            <action id="EmmyLua.Debug.OpenSettings"
                    class="com.fixcode.intellij.lua.debug.ui.settings.OpenLuaDebugSettingsAction"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <!-- 变量树右键：按类型固定 / 隐藏字段，写进显示规则文件（variable-view.md 11.1、16） -->
        <group id="EmmyLua.Debug.ViewRules">
            <separator/>
            <action id="EmmyLua.Debug.PinField" class="com.fixcode.intellij.lua.debug.xdebugger.LuaPinFieldAction" text="固定到顶部"/>
            <action id="EmmyLua.Debug.HideField" class="com.fixcode.intellij.lua.debug.xdebugger.LuaHideFieldAction" text="隐藏此字段"/>
            <add-to-group group-id="XDebugger.ValueGroup" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
