<?xml version="1.0" encoding="UTF-8"?>
<templateSet group="Lua">
    <template description="function ... end"
              name="func" toReformat="false" toShortenFQNames="true"
              value="function $FN$($PARAMS$)&#10;$END$&#10;end">
        <variable name="FN" expression="" defaultValue="&quot;funcName&quot;" alwaysStopAt="true" />
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="local function ... end"
              name="lfunc" toReformat="false" toShortenFQNames="true"
              value="local function $FN$($PARAMS$)&#10;$END$&#10;end">
        <variable name="FN" expression="" defaultValue="&quot;funcName&quot;" alwaysStopAt="true" />
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="for i = 1, n do ... end"
              name="for" toReformat="false" toShortenFQNames="true"
              value="for $VAR$ = 1, $EXPR$ do&#10;$END$&#10;end">
        <variable name="VAR" expression="" defaultValue="&quot;i&quot;" alwaysStopAt="true" />
        <variable name="EXPR" expression="" defaultValue="&quot;10&quot;" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="for i, v in ipairs(t) do ... end"
              name="fori" toReformat="false" toShortenFQNames="true"
              value="for $VAR1$, $VAR2$ in ipairs($EXPR$) do&#10;$END$&#10;end">
        <variable name="VAR1" expression="" defaultValue="&quot;i&quot;" alwaysStopAt="true" />
        <variable name="VAR2" expression="" defaultValue="&quot;v&quot;" alwaysStopAt="true" />
        <variable name="EXPR" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="for k, v in pairs(t) do ... end"
              name="forp" toReformat="false" toShortenFQNames="true"
              value="for $VAR1$, $VAR2$ in pairs($EXPR$) do&#10;$END$&#10;end">
        <variable name="VAR1" expression="" defaultValue="&quot;i&quot;" alwaysStopAt="true" />
        <variable name="VAR2" expression="" defaultValue="&quot;v&quot;" alwaysStopAt="true" />
        <variable name="EXPR" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="if ... then ... end"
              name="if" toReformat="false" toShortenFQNames="true"
              value="if $VAR$ then&#10;$END$&#10;end">
        <variable name="VAR" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="elseif"
              name="elseif" toReformat="false" toShortenFQNames="true"
              value="elseif $VAR$ then&#10;$END$">
        <variable name="VAR" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="ifelse"
              name="ifelse" toReformat="false" toShortenFQNames="true"
              value="if $VAR$ then&#10;$END$&#10;else&#10;end">
        <variable name="VAR" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

    <template description="closure"
              name="closure" toReformat="false" toShortenFQNames="true"
              value="function($PARAMS$) $END$ end">
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="LUA_CODE" value="true" />
        </context>
    </template>

</templateSet>